services:
  openclaw-gateway:
    image: ${OPENCLAW_IMAGE:-ghcr.io/openclaw/openclaw:latest}
    container_name: openclaw-gateway

    command:
      - node
      - openclaw.mjs
      - gateway
      - --allow-unconfigured
      - --bind
      - lan

    env_file:
      - .env

    environment:
      OPENCLAW_GATEWAY_TOKEN: ${OPENCLAW_GATEWAY_TOKEN}

    ports:
      - "19001:18789"
      - "19002:18791"

    volumes:
      - ./data:/home/node/.openclaw
      - ./data/workspace:/workspace:rw
      - /home/ricardo/DEV/ricardomboukou:/projects/ricardomboukou:rw
      - /home/ricardo/DEV/quizflip:/projects/quizflip:rw
      - /home/ricardo/DEV/noceflorale:/projects/noceflorale:rw
      - /home/ricardo/DEV/fininside:/projects/fininside:rw
      - /home/ricardo/DEV/enidpath:/projects/enidpath:rw

    user: "1000:1000"
    restart: unless-stopped
