# .env.example - Hugging Face Configuration Template

# ===============================================
# Hugging Face API Configuration
# ===============================================

# Your Hugging Face API Token
# Get from: https://huggingface.co/settings/tokens
# Permissions needed: "repo" (for model access) + "write" (for fine-tuning/uploads)
HUGGINGFACE_API_TOKEN=hf_xxxxxxxxxxxxx

# ===============================================
# Model Selection
# ===============================================

# Text Generation Model
# Popular: mistralai/Mistral-7B-Instruct-v0.2, meta-llama/Llama-2-7b-chat-hf
HF_TEXT_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Image Generation Model
# Popular: stabilityai/stable-diffusion-3-medium, black-forest-labs/FLUX.1-dev
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium

# Embedding Model (for semantic search)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vision Model (for image classification)
HF_VISION_MODEL=google/vit-base-patch16-224

# ===============================================
# Inference Settings
# ===============================================

# Max tokens for text generation
HF_MAX_TOKENS=512

# Temperature for generation (0.0-1.0, higher = more creative)
HF_TEMPERATURE=0.7

# Top-p for nucleus sampling (0.0-1.0)
HF_TOP_P=0.95

# ===============================================
# Caching & Storage
# ===============================================

# Cache directory for downloaded models (Docker)
HF_HOME=/home/node/.cache/huggingface

# Datasets cache (Docker)
HF_DATASETS_CACHE=/home/node/.cache/huggingface/datasets

# Use offline mode (if models pre-downloaded)
HF_OFFLINE_MODE=false

# ===============================================
# Spaces Integration (Optional)
# ===============================================

# Your Hugging Face Space ID for embedding
NEXT_PUBLIC_HF_SPACE_ID=your-username/your-space-name

# ===============================================
# Rate Limiting (Optional)
# ===============================================

# Max requests per hour (0 = unlimited)
HF_RATE_LIMIT=0

# Cache duration in seconds
HF_CACHE_TTL=3600

# ===============================================
# Monitoring & Logging
# ===============================================

# Enable HF API debug logging
HF_DEBUG=false

# Log inference costs
HF_LOG_COSTS=true
