# =========================
# OpenClaw runtime data
# =========================
data/*
!data/.gitkeep
!data/workspace/

# Keep workspace structure but ignore runtime files
data/logs/
data/media/inbound/*
!data/media/inbound/.gitkeep
data/agents/*/sessions/*.jsonl
data/agents/*/sessions/*.jsonl.reset.*
data/cron/jobs.json.bak*
data/cron/jobs.json.*
data/devices/*.bak*
data/identity/*.bak*
data/workspace/.env*
data/workspace/.next/
data/workspace/node_modules/

# Timestamped manual backups (*.bak-YYYYMMDDHHMMSS style dirs)
*.bak-[0-9]*
*.local-backup-[0-9]*
data/workspace/openclaw-workspace-state.json
data/workspace/*/openclaw-workspace-state.json

# =========================
# Secrets / Authentication
# =========================
**/auth-profiles.json
**/*token*
**/*secret*
.env
.env.local
.env.*.local
.env.production.local
.env.development.local
.env.test.local
*.key
*.pem
secrets/
.secrets/
private/

# =========================
# Logs
# =========================
*.log
logs/
*.jsonl.reset.*
**/*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# Memory / Databases
# =========================
*.sqlite
*.sqlite3
*.db
*.db-journal
.prisma/

# =========================
# Docker
# =========================
docker-compose.override.yml
.dockerignore
*.pid
*.sock

